{
  "info": {
    "name": "Music records",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    { "key": "loginUsername", "value": "" },
    { "key": "loginPassword", "value": "" },
    { "key": "loginRole", "value": "Editor" }
  ],
  "item": [
    {
      "name": "See all music records",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/musicrecords"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Record list and field types\", () => {",
              " const records = pm.response.json(); pm.expect(records).to.be.an(\"array\");",
              " records.forEach(r => { pm.expect(r.title).to.be.a(\"string\"); pm.expect(r.artist).to.be.a(\"string\"); [r.id, r.duration, r.publicationYear].forEach(v => pm.expect(Number.isInteger(v)).to.eql(true)); });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search by title, artist and year",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/musicrecords?title=blue&artist=miles&publicationYear=1959"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Only the matching record is returned', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().map(record => record.title)).to.eql(['Kind of Blue']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject an invalid publication year",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/musicrecords?publicationYear=invalid"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"]
          }
        }
      ]
    },
    {
      "name": "Log in and receive a JWT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{{loginBody}}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": ["pm.variables.set('loginBody', JSON.stringify({ username: pm.variables.get('loginUsername'), password: pm.variables.get('loginPassword') }));"]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP 200 and matching account', () => {",
              "  pm.response.to.have.status(200);",
              "  const session = pm.response.json();",
              "  pm.expect(session.username).to.eql(pm.variables.get('loginUsername'));",
              "  pm.expect(session.role).to.eql(pm.variables.get('loginRole'));",
              "  pm.expect(Date.parse(session.expiresAt)).to.be.above(Date.now());",
              "  pm.variables.set('editorToken', session.token);",
              "});",
              "pm.test('JWT contains the user and role claims', () => {",
              "  const parts = pm.response.json().token.split('.');",
              "  pm.expect(parts).to.have.lengthOf(3);",
              "  const bytes = require('buffer').Buffer.from(parts[1].replace(/-/g, '+').replace(/_/g, '/'), 'base64');",
              "  const claims = JSON.parse(bytes.toString('utf8'));",
              "  pm.expect(claims.sub).to.eql(pm.variables.get('loginUsername'));",
              "  pm.expect(claims.role).to.eql(pm.variables.get('loginRole'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject an incorrect password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{{invalidLoginBody}}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": ["pm.variables.set('invalidLoginBody', JSON.stringify({ username: pm.variables.get('loginUsername'), password: pm.variables.replaceIn('{{$guid}}') }));"]
          }
        },
        {
          "listen": "test",
          "script": { "exec": ["pm.test('HTTP 401 without a token', () => { pm.response.to.have.status(401); pm.expect(pm.response.text()).not.to.include('token'); });"] }
        }
      ]
    },
    {
      "name": "Reject a missing password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\": \"test-editor\"}" },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('HTTP 400', () => pm.response.to.have.status(400));"] }
        }
      ]
    },
    {
      "name": "Reject unsigned creation",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/musicrecords",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Unauthenticated\",\"artist\":\"Postman test\",\"duration\":125,\"publicationYear\":2024}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create a music record as Editor",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/musicrecords",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{editorToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"{{newRecordTitle}}\",\"artist\":\"Postman test\",\"duration\":125,\"publicationYear\":2024}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('newRecordTitle', 'Postman ' + pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 and a resource location', () => {",
              "  pm.response.to.have.status(201);",
              "  const record = pm.response.json();",
              "  pm.expect(record.id).to.be.above(0);",
              "  pm.expect(record.title).to.eql(pm.variables.get('newRecordTitle'));",
              "  pm.expect(pm.response.headers.get('Location')).to.include('/api/musicrecords/' + record.id);",
              "  pm.variables.set('createdRecordId', record.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete the created record as Editor",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/musicrecords/{{createdRecordId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{editorToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify the deleted record is gone",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/musicrecords/{{createdRecordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
